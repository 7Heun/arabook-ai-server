# ─── 복사해서 .env 로 쓰세요 ─────────────────────────────────────────────
# cp .env.example .env  (`.env`는 .gitignore에 있어 커밋되지 않습니다)

# OpenAI (LLM 분류/생성, 임베딩)
OPENAI_API_KEY=sk-...

# 사용할 모델 (선택, 기본값 그대로 두면 기존 동작과 같습니다)
OPENAI_CHAT_MODEL=gpt-4
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002

# 알라딘 도서 API (ISBN 조회, 베스트셀러)
# 발급: https://www.aladin.co.kr/ttb/wblog_manage.aspx
ALADIN_TTBKEY=

# Chroma 벡터 저장소 경로/컬렉션 (선택)
CHROMA_PERSIST_DIRECTORY=./chroma_db
CHROMA_COLLECTION_NAME=books

# 카테고리 사전 파일 경로 (선택)
CATEGORIES_PATH=categories.txt

# 외부 HTTP 요청 타임아웃(초)
HTTP_TIMEOUT_SECONDS=10

# 주기 작업(매일 00:01 추천 생성, 매월 1일 베스트셀러 갱신)
# 워커를 2개 이상 띄우는 배포에서는 false로 두고 스케줄러를 한 곳에서만 켜세요.
SCHEDULER_ENABLED=true

# 로그 레벨 (DEBUG/INFO/WARNING/ERROR)
LOG_LEVEL=INFO

# ─── MySQL (SSH 터널 경유) ──────────────────────────────────────────────
SSH_TUNNEL_HOST_ADDRESS=
SSH_TUNNEL_HOST_PORT=22
SSH_USERNAME=
# SSH 개인 키 파일 경로 (컨테이너에서는 마운트한 경로)
SSH_PRIVATE_KEY=
MYSQL_SERVER_HOST=
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE_NAME=
